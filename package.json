{
  "name": "valence-bot",
  "version": "1.0.0",
  "description": "Small bot for RuneScape",
  "main": "./src/index.js",
  "scripts": {
    "start": "node ./src/index.js",
    "start:messaging": "node ./src/messaging/index.js",
    "dev": "cross-env NODE_ENV=DEV node ./src/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\""
  },
  "author": "Luke",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "camelcase": "^9.0.0",
    "discord.js": "^14.28.1",
    "dotenv": "^17.4.2",
    "mongodb": "7.9",
    "node-cron": "^4.6.0",
    "pretty-ms": "^9.3.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "neostandard": "^0.14.1",
    "prettier": "3.10.1"
  }
}
